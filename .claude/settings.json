{
  "permissions": {
    "allow": [
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(./scripts/validate-build.ps1 *)",
      "PowerShell(./scripts/run-tests.ps1 *)",
      "PowerShell(./scripts/check-migrations.ps1 *)",
      "PowerShell(./scripts/pre-commit-check.ps1 *)",
      "PowerShell(./scripts/docs/check-docs.ps1 *)",
      "PowerShell(python .claude/hooks/test_guard.py)",
      "Bash(python .claude/hooks/test_guard.py)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw -B test *)",
      "Bash(./mvnw -q -B test *)",
      "Bash(./mvnw verify *)",
      "Bash(./mvnw -B verify *)",
      "PowerShell(./mvnw test *)",
      "PowerShell(./mvnw verify *)",
      "Bash(uv run pytest *)",
      "Bash(uv run --extra dev pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run --extra dev ruff check *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run --extra dev pytest *)",
      "PowerShell(uv run ruff check *)",
      "PowerShell(uv run --extra dev ruff check *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm build *)",
      "PowerShell(docker compose -f docker-compose.v2.yml ps *)",
      "PowerShell(docker compose -f docker-compose.v2.yml logs *)",
      "PowerShell(docker compose -f docker-compose.v2.yml up -d *)",
      "PowerShell(docker compose -f docker-compose.v2.yml down)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git checkout main*)",
      "PowerShell(git checkout main*)",
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git branch -D*)",
      "PowerShell(git branch -D*)",
      "Bash(git worktree remove*)",
      "PowerShell(git worktree remove*)",
      "Bash(docker volume prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker system prune*)",
      "Bash(*reset-and-bootstrap*)",
      "PowerShell(*reset-and-bootstrap*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/agents/v2-reviewer.md)",
      "Edit(./docker-compose.v2.yml)",
      "Edit(./docker-compose.yml)",
      "Edit(./.github/workflows/**)",
      "Edit(./services/auth-service/**)",
      "Edit(./services/user-service/**)",
      "Edit(./services/knowledge-service/**)",
      "Edit(./services/metadata-service/**)",
      "Edit(./services/feedback-service/**)",
      "Edit(./services/ai-qa-service/**)",
      "Edit(./services/ingestion-service/**)",
      "Edit(./services/api-gateway/**)",
      "Edit(./infrastructure/init-db/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
