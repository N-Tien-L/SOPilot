# ============================================================
# SOPilot V2 - infrastructure environment (root)
#
# Read by docker-compose.v2.yml (Postgres, Flyway, MinIO) and by eval/ and
# tests/tenant-isolation. The apps have their own files:
#   services/core-api/.env.example
#   services/ai-service/.env.example
# Where a value must match across files it is marked "same as ...".
#
# Setup: copy to .env, replace every <placeholder>, never commit .env.
# Secrets: `openssl rand -hex 32` (or any random string of 32+ characters).
# ============================================================

# --- Postgres (superuser + the three roles from infrastructure/db/init/01-roles.sh) ---
V2_POSTGRES_SUPERUSER_PASSWORD=<generate-random-32-char-password>
V2_DB_MIGRATOR_PASSWORD=<generate-random-32-char-password>
# Role sopilot_core_app (core-api). core-api file: SOPILOT_DB_PASSWORD uses the same value.
V2_DB_CORE_APP_PASSWORD=<generate-random-32-char-password>
# Role sopilot_ai_app (ai-service). ai-service file: the password inside SOPILOT_DB_URL uses the same value.
V2_DB_AI_APP_PASSWORD=<generate-random-32-char-password>

# --- Host ports, bound to 127.0.0.1 (defaults shown) ---
V2_POSTGRES_PORT=55432
V2_MINIO_API_PORT=59000
V2_MINIO_CONSOLE_PORT=59001

# --- MinIO root account: console login and bucket bootstrap only, apps never use it ---
V2_MINIO_ROOT_USER=sopilot-v2-admin
V2_MINIO_ROOT_PASSWORD=<generate-random-32-char-password>

# --- Bucket and the two least-privilege S3 users created by minio-init ---
SOPILOT_S3_BUCKET=sopilot-v2-documents
# core-api (read/write). core-api file: SOPILOT_S3_ACCESS_KEY / SOPILOT_S3_SECRET_KEY, same values.
SOPILOT_S3_ACCESS_KEY=sopilot-core
SOPILOT_S3_SECRET_KEY=<generate-random-32-char-password>
# ai-service (read-only). ai-service file: SOPILOT_S3_AI_ACCESS_KEY / SOPILOT_S3_AI_SECRET_KEY, same values.
SOPILOT_S3_AI_ACCESS_KEY=sopilot-ai
SOPILOT_S3_AI_SECRET_KEY=<generate-random-32-char-password>

# --- Provider smoke checks (optional) ---
# Used only by eval/provider_check/check_providers.py and scripts/check_llm_providers.py, which read
# this file. The running services read no LLM key today (V2-10 is not implemented).
# GROQ_API_KEY=<your-groq-api-key>
# GEMINI_API_KEY=<your-gemini-api-key>

# --- ai-service answer LLM (V2-10, ADR-006 §4.4): one self-hosted OpenAI-compatible endpoint on Modal ---
# Dummy values. Put the real endpoint, model id (as listed by GET {base}/models) and key in your local
# secrets file. Read through config/models.yaml (providers.modal, llm.generate, llm.rewrite).
SOPILOT_LLM_BASE_URL=https://<your-modal-endpoint>/v1
SOPILOT_LLM_MODEL=<model-id-served-by-the-endpoint>
SOPILOT_LLM_API_KEY=<your-endpoint-key>
# Placeholders until measured on the endpoint (TECH §7.4): our own server limits.
SOPILOT_LLM_RPM=60
SOPILOT_LLM_TPM=200000
# Empty = no ceiling declared yet; set it once the model's context limit is measured.
SOPILOT_LLM_CONTEXT_MAX_TOKENS=
