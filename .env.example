# ============================================================
# SOPilot V2 - single environment file (root .env)
#
# Source of truth for docker-compose.yml (every ${VAR} it interpolates), for eval/ and for
# tests/tenant-isolation, and for running core-api and ai-service from source.
# Compose reads only the names it references; the other keys are inert for containers.
#
# Setup: copy to .env, replace every <placeholder>, never commit .env.
# Secrets: `openssl rand -hex 32` (or any random string of 32+ characters).
#
# Kept OUT of this file, in the owning app's own env file, because the same name means a
# different format in two services or the app reads its own env file:
#   SOPILOT_DB_URL             core-api: JDBC URL; ai-service: libpq URL (see the app files)
#   SOPILOT_S3_ENDPOINT        core-api: with scheme; ai-service: host:port, no scheme
#   frontend/web NEXT_PUBLIC_* Next.js reads only frontend/web/.env.local
# ============================================================

# --- Postgres (superuser + the three roles from infrastructure/db/init/01-roles.sh) ---
V2_POSTGRES_SUPERUSER_PASSWORD=<generate-random-32-char-password>
V2_DB_MIGRATOR_PASSWORD=<generate-random-32-char-password>
V2_DB_CORE_APP_PASSWORD=<generate-random-32-char-password>
V2_DB_AI_APP_PASSWORD=<generate-random-32-char-password>

# --- Host ports, bound to 127.0.0.1 (defaults shown) ---
V2_POSTGRES_PORT=55432
V2_MINIO_API_PORT=59000
V2_MINIO_CONSOLE_PORT=59001
V2_CORE_API_PORT=8080
V2_AI_SERVICE_PORT=8000
V2_WEB_PORT=3000

# --- MinIO root account: console login and bucket bootstrap only, apps never use it ---
V2_MINIO_ROOT_USER=sopilot-v2-admin
V2_MINIO_ROOT_PASSWORD=<generate-random-32-char-password>

# --- Bucket and the two least-privilege S3 users created by minio-init ---
SOPILOT_S3_BUCKET=sopilot-v2-documents
# core-api (read/write)
SOPILOT_S3_ACCESS_KEY=sopilot-core
SOPILOT_S3_SECRET_KEY=<generate-random-32-char-password>
# ai-service (read-only)
SOPILOT_S3_AI_ACCESS_KEY=sopilot-ai
SOPILOT_S3_AI_SECRET_KEY=<generate-random-32-char-password>

# --- Shared app secret: /internal/** (core-api <-> ai-service). Generate with `openssl rand -hex 32`. ---
SOPILOT_INTERNAL_TOKEN=<generate-random-32-char-secret>

# --- core-api ---
# Google Sign-In: the backend verifies ID tokens against this client id. Blank rejects every login.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
# Only Origin accepted by /auth/refresh and /auth/logout. Must equal the browser origin.
SOPILOT_FRONTEND_ORIGIN=http://localhost:3000

# --- Answer LLM (ADR-006 §4.4): one self-hosted OpenAI-compatible endpoint on Modal ---
# URL printed by `modal deploy infrastructure/modal/serve_vllm.py`, plus /v1.
SOPILOT_LLM_BASE_URL=https://<workspace>--sopilot-vllm-serve.modal.run/v1
# Same string as VLLM_API_KEY in the Modal secret `sopilot-vllm-secret` (infrastructure/modal/README.md).
SOPILOT_LLM_API_KEY=<same-as-modal-secret-VLLM_API_KEY>
# Model id, must match GET {base}/models.
SOPILOT_LLM_MODEL=Qwen/Qwen3.5-9B
# Answer reasoning (owner decision 2026-11-15). false = fast path. (V2-43)
SOPILOT_LLM_THINKING=true

# --- Reranker (V2-35): reuses SOPILOT_LLM_API_KEY. Used only when RERANK_ENABLED=true and RERANK_PROVIDER=modal. ---
# URL printed by `modal deploy` for the sopilot-vllm-rerank label, plus /v1. Empty is fine while off.
SOPILOT_RERANK_BASE_URL=
RERANK_ENABLED=false
RERANK_PROVIDER=local
RERANK_TIMEOUT_S=30

# --- Embeddings ---
# Hugging Face commit of BAAI/bge-m3. Empty is accepted in profile `local` (logged as "unpinned");
# pin it before ingesting documents you will evaluate on. Eval profile refuses empty.
EMBEDDING_REVISION=

# --- Semantic router, SetFit classifier (V2-44, ADR-012): off | shadow | on ---
SOPILOT_ROUTER_CLASSIFIER_MODE=off

# --- Metadata suggestions (V2-25, ai-worker only). Optional: without it the worker falls back to RULES_FALLBACK. ---
SOPILOT_GROQ_API_KEY=

# --- Provider smoke checks (optional): eval/provider_check and scripts/check_llm_providers.py only ---
# GROQ_API_KEY=<your-groq-api-key>
# GEMINI_API_KEY=<your-gemini-api-key>

# --- Running core-api and ai-service from source (host URLs; compose hardcodes its own) ---
# Host-only, no name collision with compose or with the other service:
SOPILOT_DB_USER=sopilot_core_app
SOPILOT_DB_PASSWORD=<same-as-V2_DB_CORE_APP_PASSWORD>
SOPILOT_AI_BASE_URL=http://localhost:8000
SOPILOT_CORE_BASE_URL=http://localhost:8080
SOPILOT_CORE_JWKS_URL=http://localhost:8080/.well-known/jwks.json
# core-api
# SOPILOT_S3_PUBLIC_ENDPOINT=http://localhost:59000   # signs download URLs only; blank = SOPILOT_S3_ENDPOINT
# SOPILOT_ACCESS_TTL=PT15M                    # startup fails above 15 minutes
# SOPILOT_REFRESH_TTL=P14D
# SOPILOT_REFRESH_GRACE=PT10S                 # 0 = off
# SOPILOT_JWT_KID=                            # default: key thumbprint
# SOPILOT_JWT_PRIVATE_KEY_PATH=<path-outside-repo>/core-api-jwt.pem   # required outside profiles local/test
# SOPILOT_JWT_PREVIOUS_PUBLIC_KEY_PATH=       # only while rotating the signing key
# SOPILOT_NONCE_HMAC_KEY=<generate-random-32-char-secret>             # >= 32 bytes; required outside local/test
# SOPILOT_DB_POOL_SIZE=10
# SOPILOT_QUOTA_DOCS_PER_WORKSPACE=50         # 0 = no limit
# SOPILOT_QUOTA_BYTES_PER_WORKSPACE=209715200
# SOPILOT_OUTBOX_POLL=PT5S
# GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# SERVER_PORT=8080
# ai-service
# SOPILOT_PROFILE=local                       # local | eval
# SOPILOT_S3_REGION=us-east-1                 # keep explicit: the read-only policy has no s3:GetBucketLocation
# SOPILOT_S3_SECURE=false                     # true = https to the S3 endpoint
# SOPILOT_MODELS_CONFIG=                      # default: services/ai-service/config/models.yaml
# RERANK_REVISION=
# HF_HOME=
# HF_HUB_OFFLINE=1                            # set after the first model download (eval/README.md)
# SOPILOT_LLM_MAX_OUTPUT_TOKENS=8192
# SOPILOT_LLM_CONTEXT_MAX_TOKENS=57000
# SOPILOT_LLM_RPM=60
# SOPILOT_LLM_TPM=200000
# SOPILOT_SUGGEST_MODEL=qwen/qwen3.8-27b
# SOPILOT_SUGGEST_TIMEOUT_S=20
# SOPILOT_SUGGEST_RPM=30
# SOPILOT_SUGGEST_TPM=60000
# SOPILOT_SEMANTIC_ROUTER_ENABLED=false
# SOPILOT_ROUTER_CLASSIFIER_DIR=models/setfit-router
# SOPILOT_QUOTA_QUESTIONS_PER_USER_DAY=0      # 0 = off (FR-09)
# SOPILOT_QUOTA_QUESTIONS_SYSTEM_DAY=0
# SOPILOT_MAX_QUESTION_CHARS=1000
# SOPILOT_FOLLOWUP_MAX_TOKENS=
# SOPILOT_SUPPORT_CONTACT=
# SOPILOT_TIMEZONE=Asia/Ho_Chi_Minh
# SOPILOT_OUTBOX_MAX_ATTEMPTS=20
# SOPILOT_OUTBOX_HTTP_TIMEOUT=10
# SOPILOT_INGEST_MAX_ATTEMPTS=3
# SOPILOT_INGEST_LEASE_SECONDS=600
# SOPILOT_INGEST_BACKOFF_SECONDS=30
# SOPILOT_WORKER_POLL_SECONDS=5
# SOPILOT_HEADER_FOOTER_MIN_PAGES=3
# SOPILOT_PAGE_MIN_CHARS=20
# SOPILOT_PDF_ARTIFACTS_PATH=
# SOPILOT_PDF_THREADS=4
# SOPILOT_PDF_TABLE_MODEL=v1                  # v1 | v2
# SOPILOT_PDF_TABLE_MODE=accurate             # TableFormer mode (v1 only)
# SOPILOT_PDF_CELL_MATCHING=1                 # 0 = off

# --- web (proxy.ts reads these at run time; compose sets its own service names) ---
CORE_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
