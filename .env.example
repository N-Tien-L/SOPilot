# ============================================================
# SOPilot V2 - root environment
#
# Read by docker-compose.v2.yml (Postgres, Flyway, MinIO and the core-api, ai-service and
# ai-worker containers), by eval/ and by tests/tenant-isolation. Running an app from source
# uses its own file instead:
#   services/core-api/.env.example
#   services/ai-service/.env.example
# Where a value must match across files it is marked "same as ...".
#
# Setup: copy to .env, replace every <placeholder>, never commit .env.
# Secrets: `openssl rand -hex 32` (or any random string of 32+ characters).
# ============================================================

# --- Postgres (superuser + the three roles from infrastructure/db/init/01-roles.sh) ---
V2_POSTGRES_SUPERUSER_PASSWORD=<generate-random-32-char-password>
V2_DB_MIGRATOR_PASSWORD=<generate-random-32-char-password>
# Role sopilot_core_app (core-api). core-api file: SOPILOT_DB_PASSWORD uses the same value.
V2_DB_CORE_APP_PASSWORD=<generate-random-32-char-password>
# Role sopilot_ai_app (ai-service). ai-service file: the password inside SOPILOT_DB_URL uses the same value.
V2_DB_AI_APP_PASSWORD=<generate-random-32-char-password>

# --- Host ports, bound to 127.0.0.1 (defaults shown) ---
V2_POSTGRES_PORT=55432
V2_MINIO_API_PORT=59000
V2_MINIO_CONSOLE_PORT=59001

# --- MinIO root account: console login and bucket bootstrap only, apps never use it ---
V2_MINIO_ROOT_USER=sopilot-v2-admin
V2_MINIO_ROOT_PASSWORD=<generate-random-32-char-password>

# --- Bucket and the two least-privilege S3 users created by minio-init ---
SOPILOT_S3_BUCKET=sopilot-v2-documents
# core-api (read/write). core-api file: SOPILOT_S3_ACCESS_KEY / SOPILOT_S3_SECRET_KEY, same values.
SOPILOT_S3_ACCESS_KEY=sopilot-core
SOPILOT_S3_SECRET_KEY=<generate-random-32-char-password>
# ai-service (read-only). ai-service file: SOPILOT_S3_AI_ACCESS_KEY / SOPILOT_S3_AI_SECRET_KEY, same values.
SOPILOT_S3_AI_ACCESS_KEY=sopilot-ai
SOPILOT_S3_AI_SECRET_KEY=<generate-random-32-char-password>

# --- App services (read by docker-compose.v2.yml: core-api, ai-service, ai-worker) ---
# Required: compose refuses to start without these. Shared secret for /internal/** (core-api <-> ai-service).
# Generate with `openssl rand -hex 32`. Dummy placeholder below; replace it.
SOPILOT_INTERNAL_TOKEN=<generate-random-32-char-secret>

# Required: answer LLM (ADR-006 §4.4), one self-hosted OpenAI-compatible endpoint on Modal.
# URL printed by `modal deploy infrastructure/modal/serve_vllm.py`, plus /v1. Dummy placeholder below.
SOPILOT_LLM_BASE_URL=https://<workspace>--sopilot-vllm-serve.modal.run/v1
# Same string as VLLM_API_KEY in the Modal secret `sopilot-vllm-secret` (infrastructure/modal/README.md).
SOPILOT_LLM_API_KEY=<same-as-modal-secret-VLLM_API_KEY>
# Optional: model id, default in docker-compose.v2.yml is Qwen/Qwen3.5-9B (must match GET {base}/models).
# SOPILOT_LLM_MODEL=Qwen/Qwen3.5-9B

# Optional: Groq key for metadata suggestions (V2-25, ai-worker only). Without it the worker logs
# suggest_key_missing and suggestions fall back to RULES_FALLBACK (no LLM call); the stack still starts.
# SOPILOT_GROQ_API_KEY=<groq-api-key>

# Optional: Hugging Face commit of BAAI/bge-m3, passed to ai-service and ai-worker. Empty is accepted
# in profile `local` (logged as "unpinned"); pin it before ingesting documents you will evaluate on.
# EMBEDDING_REVISION=

# --- Provider smoke checks (optional) ---
# Used only by eval/provider_check/check_providers.py and scripts/check_llm_providers.py, which read
# this file. The running services get their keys from the App services block above.
# GROQ_API_KEY=<your-groq-api-key>
# GEMINI_API_KEY=<your-gemini-api-key>

# Other ai-service variables (rate limits, worker tuning) are in services/ai-service/.env.example.
