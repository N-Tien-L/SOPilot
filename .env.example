# ============================================================
# SOPilot Environment Configuration
# Copy this file to .env and replace all placeholder values.
# NEVER commit real secrets to version control.
# ============================================================

# PostgreSQL
# Use a strong, randomly generated password in production
POSTGRES_PASSWORD=<generate-random-32-char-password>

# RabbitMQ
RABBITMQ_PASSWORD=<generate-random-32-char-password>

# Redis
REDIS_PASSWORD=<generate-random-32-char-password>

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<generate-random-32-char-password>
MINIO_BUCKET_NAME=sopilot-documents

# JWT
# Must be at least 256 bits (32+ chars) for HS256
JWT_SECRET=<generate-random-64-char-hex-string>

# Service-to-service authentication (do not reuse either value as a user role)
INTERNAL_SERVICE_TOKEN=<generate-random-64-char-hex-string>
INTERNAL_API_KEY=<generate-random-64-char-hex-string>

# Cloud Embedding API (e.g., Jina AI: https://api.jina.ai or OpenAI: https://api.openai.com)
EMBEDDING_URL=https://api.jina.ai
EMBEDDING_API_KEY=<your-embedding-api-key>
EMBEDDING_MODEL=jina-embeddings-v3

# LLM API (Groq for Metadata Suggestion Phase 1)
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile  # Recommended for fast JSON structured outputs

# Optional bootstrapping. Leave disabled after the initial controlled deployment.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email is opt-in. Keep credentials empty while disabled.
EMAIL_ENABLED=false
EMAIL_USERNAME=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=SOPilot Support
EMAIL_FROM_ADDRESS=support@sopilot.example

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Ingestion Service
INGESTION_SERVICE_PORT=8088

# Google OAuth (Milestone 1 JIT Onboarding)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Same OAuth client ID; Next.js embeds this public value at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ============================================================
# V2 local infrastructure (docker-compose.v2.yml, ticket V2-08)
# Separate project "sopilot-v2"; does not share volumes with the legacy stack.
# ============================================================
V2_POSTGRES_SUPERUSER_PASSWORD=<generate-random-32-char-password>
V2_DB_MIGRATOR_PASSWORD=<generate-random-32-char-password>
V2_DB_CORE_APP_PASSWORD=<generate-random-32-char-password>
V2_DB_AI_APP_PASSWORD=<generate-random-32-char-password>
V2_POSTGRES_PORT=55432
V2_MINIO_ROOT_USER=sopilot-v2-admin
V2_MINIO_ROOT_PASSWORD=<generate-random-32-char-password>
V2_MINIO_API_PORT=59000
V2_MINIO_CONSOLE_PORT=59001
SOPILOT_S3_BUCKET=sopilot-v2-documents
SOPILOT_S3_ACCESS_KEY=sopilot-core
SOPILOT_S3_SECRET_KEY=<generate-random-32-char-password>
SOPILOT_S3_AI_ACCESS_KEY=sopilot-ai
SOPILOT_S3_AI_SECRET_KEY=<generate-random-32-char-password>
# core-api (V2-11). GOOGLE_CLIENT_ID above is reused. local/test profiles generate the key
# and nonce secret when unset; any other profile requires both.
SOPILOT_DB_URL=jdbc:postgresql://localhost:55432/sopilot
SOPILOT_DB_USER=sopilot_core_app
SOPILOT_DB_PASSWORD=<same-as-V2_DB_CORE_APP_PASSWORD>
SOPILOT_JWT_PRIVATE_KEY_PATH=<path-outside-repo>/core-api-jwt.pem
SOPILOT_ACCESS_TTL=PT15M
# V2-29: refresh token lifetime, the only Origin accepted by /auth/refresh and /auth/logout, and (only while
# rotating the signing key) the public key of the previous key.
SOPILOT_REFRESH_TTL=P14D
SOPILOT_FRONTEND_ORIGIN=http://localhost:3000
SOPILOT_JWT_PREVIOUS_PUBLIC_KEY_PATH=
SOPILOT_NONCE_HMAC_KEY=<generate-random-32-char-secret>
# core-api documents and outbox (V2-12). S3 endpoint is the MinIO API; bucket and core keys are above.
# SOPILOT_INTERNAL_TOKEN is shared with ai-service (one token, both directions); blank rejects /internal/**.
SOPILOT_S3_ENDPOINT=http://localhost:59000
# ai-service reads S3 with SOPILOT_S3_AI_* and its own SOPILOT_S3_ENDPOINT (host:port, no scheme). SOPILOT_S3_REGION
# (default us-east-1) must stay explicit: the read-only policy has no s3:GetBucketLocation.
SOPILOT_INTERNAL_TOKEN=<generate-random-32-char-secret>
SOPILOT_AI_BASE_URL=http://ai-service:8000
# Document quota per workspace (FR-09): 50 documents / 200 MB by default, 0 turns a limit off.
SOPILOT_QUOTA_DOCS_PER_WORKSPACE=50
SOPILOT_QUOTA_BYTES_PER_WORKSPACE=209715200
SOPILOT_OUTBOX_POLL=PT5S
SOPILOT_OUTBOX_MAX_ATTEMPTS=20
