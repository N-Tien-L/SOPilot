# Backend targets, read at run time by proxy.ts (server-side only; no NEXT_PUBLIC_ prefix).
# Host (pnpm dev): the defaults below. Compose: the service names, e.g. http://core-api:8080.
CORE_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000

# core-api must have SOPILOT_FRONTEND_ORIGIN equal to the origin the browser uses
# (http://localhost:3000 for pnpm dev and the compose web service).

# Google OAuth (build-time today; V2-15 decides whether it becomes run-time)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
