# ============================================================
# core-api environment (Spring Boot, port 8080)
#
# Setup: copy to .env in this directory and replace every <placeholder>.
# Spring does not read .env itself; load it into the shell that starts the app (PowerShell):
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#\s][^=]*=' } |
#     ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$($k.Trim())" $v.Trim() }
#   ./mvnw spring-boot:run "-Dspring-boot.run.profiles=local"
# Infrastructure secrets live in the root .env.example; "same as" marks values that must match it.
# ============================================================

# --- Google Sign-In: the backend verifies ID tokens against this client id. Blank rejects every login. ---
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# --- Database: JDBC URL, role sopilot_core_app ---
SOPILOT_DB_URL=jdbc:postgresql://localhost:55432/sopilot
SOPILOT_DB_USER=sopilot_core_app
# same as V2_DB_CORE_APP_PASSWORD (root)
SOPILOT_DB_PASSWORD=<same-as-V2_DB_CORE_APP_PASSWORD>

# --- Object storage (MinIO). The endpoint needs the scheme. Missing storage fails document calls with 503. ---
SOPILOT_S3_ENDPOINT=http://localhost:59000
# same as SOPILOT_S3_BUCKET / SOPILOT_S3_ACCESS_KEY / SOPILOT_S3_SECRET_KEY (root)
SOPILOT_S3_BUCKET=sopilot-v2-documents
SOPILOT_S3_ACCESS_KEY=sopilot-core
SOPILOT_S3_SECRET_KEY=<same-as-root-SOPILOT_S3_SECRET_KEY>

# --- ai-service link ---
# Where the outbox dispatcher sends events (code default: http://ai-service:8000, for compose).
SOPILOT_AI_BASE_URL=http://localhost:8000
# One token for both directions; blank rejects every /internal/** call. same as ai-service SOPILOT_INTERNAL_TOKEN
SOPILOT_INTERNAL_TOKEN=<generate-random-32-char-secret>

# --- Token signing (only needed outside the `local`/`test` profiles) ---
# With the `local` profile the key and nonce secret are generated in memory at startup, so
# restarting core-api invalidates issued tokens. Any other profile fails to start without both.
# SOPILOT_JWT_PRIVATE_KEY_PATH=<path-outside-repo>/core-api-jwt.pem   # unencrypted PKCS#8 PEM, RSA >= 2048
# SOPILOT_NONCE_HMAC_KEY=<generate-random-32-char-secret>             # >= 32 bytes

# --- Optional (defaults shown) ---
# SOPILOT_S3_REGION=us-east-1
# SOPILOT_ACCESS_TTL=PT15M                    # startup fails above 15 minutes
# SOPILOT_JWT_KID=                            # default: key thumbprint
# GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# SOPILOT_DB_POOL_SIZE=10
# SERVER_PORT=8080
# Document quota per workspace (FR-09); 0 turns a limit off.
# SOPILOT_QUOTA_DOCS_PER_WORKSPACE=50
# SOPILOT_QUOTA_BYTES_PER_WORKSPACE=209715200
# Outbox dispatcher: poll interval (ISO-8601) and attempts before DEAD.
# SOPILOT_OUTBOX_POLL=PT5S
# SOPILOT_OUTBOX_MAX_ATTEMPTS=20
