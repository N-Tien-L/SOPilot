# ============================================================
# ai-service environment (FastAPI API on port 8000 + ingest worker)
#
# Setup: copy to .env in this directory and replace every <placeholder>.
# pydantic-settings is not given an env file; load it into the shell that starts the process (PowerShell):
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#\s][^=]*=' } |
#     ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$($k.Trim())" $v.Trim() }
#   uv run uvicorn --app-dir src sopilot_ai.api.app:create_app --factory
#   $env:PYTHONPATH="src"; uv run python -m sopilot_ai.worker
# Infrastructure secrets live in the root .env.example; "same as" marks values that must match it.
# ============================================================

# --- Database: libpq-style URL with credentials, role sopilot_ai_app (not the JDBC form core-api uses) ---
# The password is the root V2_DB_AI_APP_PASSWORD.
SOPILOT_DB_URL=postgresql://sopilot_ai_app:<same-as-V2_DB_AI_APP_PASSWORD>@localhost:55432/sopilot

# --- core-api link ---
# One token for both directions; startup fails without it. same as core-api SOPILOT_INTERNAL_TOKEN
SOPILOT_INTERNAL_TOKEN=<generate-random-32-char-secret>
# Code defaults point at the compose hostname core-api:8080; these are for running from source.
SOPILOT_CORE_BASE_URL=http://localhost:8080
SOPILOT_CORE_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# --- Object storage (MinIO), read-only user ---
# host:port WITHOUT a scheme (the MinIO client takes the scheme from SOPILOT_S3_SECURE).
# Code default is minio:9000 (compose hostname).
SOPILOT_S3_ENDPOINT=localhost:59000
# same as SOPILOT_S3_BUCKET / SOPILOT_S3_AI_ACCESS_KEY / SOPILOT_S3_AI_SECRET_KEY (root)
SOPILOT_S3_BUCKET=sopilot-v2-documents
SOPILOT_S3_AI_ACCESS_KEY=sopilot-ai
SOPILOT_S3_AI_SECRET_KEY=<same-as-root-SOPILOT_S3_AI_SECRET_KEY>

# --- Embedding / rerank models (expanded inside config/models.yaml) ---
# Hugging Face commit of BAAI/bge-m3. Empty is accepted in profile `local` (logged as "unpinned")
# and is a startup error in profile `eval`.
EMBEDDING_REVISION=

# --- Optional (defaults shown) ---
# SOPILOT_PROFILE=local                       # local | eval
# SOPILOT_S3_REGION=us-east-1                 # keep explicit: the read-only policy has no s3:GetBucketLocation
# SOPILOT_S3_SECURE=false                     # true = https to the S3 endpoint
# SOPILOT_MODELS_CONFIG=                      # default: config/models.yaml
# Reranker is off; pin its revision when you turn it on.
# RERANK_ENABLED=false
# RERANK_REVISION=
# Hugging Face cache for downloaded models; set HF_HUB_OFFLINE=1 after the first download (eval/README.md).
# HF_HOME=
# HF_HUB_OFFLINE=1
# Ingest worker.
# SOPILOT_INGEST_MAX_ATTEMPTS=3
# SOPILOT_INGEST_LEASE_SECONDS=600
# SOPILOT_INGEST_BACKOFF_SECONDS=30
# SOPILOT_WORKER_POLL_SECONDS=5
# Question answering (V2-10). Answer LLM (ADR-006 §4.4): one self-hosted OpenAI-compatible endpoint on Modal,
# read through config/models.yaml (providers.modal, llm.generate, llm.rewrite). eval/ takes it from the same shell variables.
# URL printed by `modal deploy infrastructure/modal/serve_vllm.py` (https://<workspace>--sopilot-vllm-serve.modal.run), plus /v1.
SOPILOT_LLM_BASE_URL=https://<workspace>--sopilot-vllm-serve.modal.run/v1
# Model id as listed by GET {base}/models.
SOPILOT_LLM_MODEL=Qwen/Qwen3.5-9B
# Same string as VLLM_API_KEY in the Modal secret `sopilot-vllm-secret` (infrastructure/modal/README.md).
# Generate: `openssl rand -hex 32`. Stored in two places only: Modal and your local .env.
SOPILOT_LLM_API_KEY=<same-as-modal-secret-VLLM_API_KEY>
# Placeholders until measured on the endpoint (TECH §7.4): our own server limits.
SOPILOT_LLM_RPM=60
SOPILOT_LLM_TPM=200000
# Empty = no ceiling declared yet. The Modal deployment serves --max-model-len 8192, so 8192 is the upper bound.
SOPILOT_LLM_CONTEXT_MAX_TOKENS=
# Question quotas are off: 0 = no limit and no counter is read or written (FR-09, TECH §7.4).
# SOPILOT_QUOTA_QUESTIONS_PER_USER_DAY=0
# SOPILOT_QUOTA_QUESTIONS_SYSTEM_DAY=0
# SOPILOT_MAX_QUESTION_CHARS=1000             # longer questions are refused, never cut
# SOPILOT_FOLLOWUP_MAX_TOKENS=                # empty = value of qa/followup_rules.yaml
# SOPILOT_SUPPORT_CONTACT=                    # shown with the self-harm sentence; empty = sentence without contact
# SOPILOT_TIMEZONE=Asia/Ho_Chi_Minh           # the "Hôm nay là ..." line of the prompt and the quota day
# Outbox to core-api.
# SOPILOT_OUTBOX_MAX_ATTEMPTS=20
# SOPILOT_OUTBOX_HTTP_TIMEOUT=10
# Document processing; starting values, to be settled on the V2-19 corpus.
# SOPILOT_HEADER_FOOTER_MIN_PAGES=3
# SOPILOT_PAGE_MIN_CHARS=20
# PDF extraction (Docling, ADR-008).
# SOPILOT_PDF_ARTIFACTS_PATH=                 # preloaded Docling models; empty = library default
# SOPILOT_PDF_THREADS=4
# SOPILOT_PDF_TABLE_MODEL=v1                  # v1 | v2
# SOPILOT_PDF_TABLE_MODE=accurate             # TableFormer mode (v1 only)
# SOPILOT_PDF_CELL_MATCHING=1                 # 0 turns cell matching off

# --- LLM providers ---
# The running service reads no LLM key today: the answer pipeline (V2-10) is not implemented and the
# owner chose self-hosted models on Modal (PLAN-V2, 2026-11-01). Add provider variables here with V2-10.
