   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Cross-schema rule (ADR-004)\nNo foreign key between core and rag.\ndocument_id, version_id, workspace_id and\nuser_id are plain uuid copies. The two\nservices sync them over HTTP through the\noutbox (amber dashed lines).",
   "originalText": "Cross-schema rule (ADR-004)\nNo foreign key between core and rag.\ndocument_id, version_id, workspace_id and\nuser_id are plain uuid copies. The two\nservices sync them over HTTP through the\noutbox (amber dashed lines).",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
